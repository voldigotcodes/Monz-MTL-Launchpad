# Frontend (Next.js)
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Backend (launcher/config.py reads these)
META_ACCESS_TOKEN=YOUR_META_TOKEN
META_AD_ACCOUNT_ID=act_1234567890
META_PAGE_ID=1234567890
META_INSTAGRAM_ACCOUNT_ID=1234567890
META_PIXEL_ID=1234567890
META_COUNTRY=CA
META_CURRENCY=CAD
META_GRAPH_API_VERSION=v18.0
# Video upload socket inactivity timeout in seconds (separate from ordinary API calls)
META_VIDEO_UPLOAD_TIMEOUT=600
META_OBJECTIVE=OUTCOME_SALES
META_DAILY_BUDGET=8000
META_OPTIMIZATION_EVENT=OFFSITE_CONVERSIONS

# CORS (allow the Next.js dev server)
META_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upload/job temp settings (optional)
LAUNCHPAD_UPLOAD_TTL_SEC=21600
LAUNCHPAD_MAX_UPLOAD_FILES=5000
LAUNCHPAD_MAX_ZIP_BYTES=536870912

# Optional: backend-local JSON file for selected asset IDs (token stays in .env)
# LAUNCHPAD_ASSETS_PATH=/absolute/path/to/meta-assets.json
